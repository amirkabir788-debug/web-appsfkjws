{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appsfkjws",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9c7d8a10-0e1f-49e5-8501-b7fbeb3be795","database_name": "web-appjgfkgk" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2d847f86205e44d19d637880d1c1b678" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
